{
  "name": "watchrss-podjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --path-ignore-patterns='artifacts/**'",
    "typecheck": "bun scripts/link-framework.ts --check && tsc --noEmit",
    "build": "bun ../podjs-watch-framework.wt-systemsettings/packages/cli/src/cli.ts build --target=android-watch --project=\"$PWD\"",
    "package:android": "bun ../podjs-watch-framework.wt-systemsettings/packages/cli/src/cli.ts package --target=android-watch --project=\"$PWD\"",
    "postinstall": "bun scripts/link-framework.ts"
  },
  "dependencies": {
    "@pocketjs/framework": "file:../podjs-watch-framework.wt-systemsettings/vendor/pocketjs",
    "@podjs/framework": "file:../podjs-watch-framework.wt-systemsettings/packages/framework",
    "entities": "7.0.1",
    "qrcode-generator": "1.4.4",
    "solid-js": "1.9.9"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.3.10"
  },
  "overrides": {
    "@pocketjs/framework": "file:../podjs-watch-framework.wt-systemsettings/vendor/pocketjs"
  },
  "imports": {
    "#sync-v2-build": {
      "bun": "./tests/sync-v2/test-build.ts",
      "default": "./src/sync-v2/release-build.ts"
    }
  }
}
