{
  "name": "watchrss-podjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --path-ignore-patterns='artifacts/**'",
    "typecheck": "bun scripts/link-framework.ts --check && tsc --noEmit",
    "build": "bun scripts/framework-cli.ts build",
    "package:android": "bun scripts/framework-cli.ts package",
    "postinstall": "bun scripts/link-framework.ts",
    "lint": "python3 scripts/lint.py",
    "test-gate": "./test-gate"
  },
  "dependencies": {
    "@pocketjs/framework": "file:../../PodJS/podjs-watch/vendor/pocketjs",
    "@podjs/framework": "file:../../PodJS/podjs-watch/packages/framework",
    "entities": "7.0.1",
    "qrcode-generator": "1.4.4",
    "solid-js": "1.9.9"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.3.10",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript-eslint": "8.48.0"
  },
  "overrides": {
    "@pocketjs/framework": "file:../../PodJS/podjs-watch/vendor/pocketjs"
  },
  "imports": {
    "#sync-v2-build": {
      "bun": "./tests/sync-v2/test-build.ts",
      "default": "./src/sync-v2/release-build.ts"
    },
    "#cloud-background-entry": {
      "default": "./src/cloud/background-v2-entry.ts"
    },
    "#douyin-transport-build": {
      "default": "./src/douyin/transport-build.ts"
    }
  },
  "packageManager": "bun@1.4.4"
}
